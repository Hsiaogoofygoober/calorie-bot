# LINE Developers Console → Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google AI Studio → Get API key
GEMINI_API_KEY=
# 辨識用模型，可換成更便宜的 Flash-Lite
GEMINI_MODEL=gemini-3.8-flash
# 主模型忙碌（503）時自動改用的備援模型
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# false：熱量完全由 AI 估計（預設）；true：data/foods.csv 查得到的優先用資料庫
USE_NUTRITION_DB=false

# 預設每日目標熱量（每個人可用「目標 1800」自行修改）
DEFAULT_GOAL_KCAL=1800
DB_PATH=calorie.db
